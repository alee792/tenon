{
  "run": "skill-mix",
  "strategy": "genetic",
  "repo": ".",
  "agent": "agent",
  "harness": "claude",
  "tasks": [
    "Fix the failing test in internal/apply.",
    "Add a table-driven test for the duration parser.",
    "Tighten the error message on a rejected pin set."
  ],
  "repeats": 2,
  "score": "sh improve/examples/score-tests.sh",
  "generations": 8,
  "population": 6,
  "crossover_rate": 0.6,
  "mutation_rate": 0.8,
  "tournament": 3,
  "patience": 3,
  "max_evaluations": 200,
  "concurrency": 4,
  "timeout": "900s",
  "rng_seed": 1,
  "operators": [
    {
      "name": "edit",
      "weight": 5,
      "command": "sh \"$EVOLVE_CWD\"/improve/examples/operators/edit-llm.sh"
    },
    {
      "name": "grow",
      "weight": 3,
      "command": "sh \"$EVOLVE_CWD\"/improve/examples/operators/grow-skill.sh"
    },
    {
      "name": "prune",
      "weight": 2,
      "command": "python3 \"$EVOLVE_CWD\"/improve/examples/operators/prune-gene.py"
    }
  ]
}
