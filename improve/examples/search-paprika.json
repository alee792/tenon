{
  "run": "paprika",
  "strategy": "genetic",
  "repo": ".",
  "agent": "agent",
  "harness": "claude",
  "model": "claude-haiku-4-5-20251001",
  "tasks": [
    "Explain what this repository does to a new contributor, in under 120 words."
  ],
  "repeats": 1,
  "score": "python3 improve/judge/score-pairwise.py",
  "operators": [
    {
      "name": "edit",
      "weight": 1,
      "command": "sh \"$EVOLVE_CWD/improve/judge/mutate-instructions.sh\""
    }
  ],
  "generations": 2,
  "population": 2,
  "reevaluate": "incumbent",
  "concurrency": 5,
  "timeout": "600s",
  "rng_seed": 1,
  "offspring": 5,
  "crossover_rate": 0,
  "tournament": 2
}
