// Code generated by tenon; DO NOT EDIT.
//
// Tenon's Go tool host.
//
// One long-lived process serves every tools/NAME package of one agent project
// over tenon's line-delimited host protocol on stdin and stdout: one request
// object per line in, one response object per line out. The protocol is
// tenon's own, not MCP; the managed MCP boundary lives in tenon and speaks to
// this host, so authors never write protocol code.
//
// Authored contract: each tools/NAME/tool.go declares Description, Input,
// Output, and Execute(context.Context, Input) (Output, error), and never
// imports tenon. This host renders each Input and Output as a JSON Schema by
// reflection, validates every argument against the input schema before
// authored code runs, and validates every result against the output schema
// before it leaves.
//
// Every failure is answered in-band as a bounded error string. Nothing is
// written to stderr on the request path: tenon never forwards host stderr into
// a model-visible or operator-visible message.
package main

import (
	"bufio"
	"bytes"
	"context"
	"encoding/json"
	"errors"
	"fmt"
	"io"
	"os"
	"reflect"
	"sort"
	"strings"
{{range .Imports}}
	{{.Alias}} "{{.Path}}"
{{- end}}
)

func main() {
	hostMain([]registration{
{{- range .Tools}}
		newTool[{{.Alias}}.Input, {{.Alias}}.Output]({{printf "%q" .Name}}, {{.Alias}}.Description, {{.Alias}}.Execute),
{{- end}}
	})
}

const (
	// maxLineBytes bounds one request line, matching tenon's own bound.
	maxLineBytes = 64 << 10
	// maxErrorChars bounds one in-band error message.
	maxErrorChars = 1024
	// maxSchemaDepth bounds reflection so a recursive authored type is
	// refused rather than expanded forever.
	maxSchemaDepth = 16
)

// registration is one authored tool, erased to a uniform shape: its published
// schemas plus a closure that validates, runs, and validates again.
type registration struct {
	name        string
	description string
	input       map[string]any
	output      map[string]any
	call        func(ctx context.Context, requestID string, arguments json.RawMessage) (json.RawMessage, error)
	err         error
}

// newTool registers one authored tool. A type this host cannot render as a
// schema is remembered as an error and reported in band rather than crashing
// the host at startup.
func newTool[I any, O any](name, description string, execute func(context.Context, I) (O, error)) registration {
	r := registration{name: name, description: description}
	if strings.TrimSpace(description) == "" {
		r.err = fmt.Errorf("tool %q must export a non-empty Description", name)
		return r
	}
	inputType := reflect.TypeOf((*I)(nil)).Elem()
	outputType := reflect.TypeOf((*O)(nil)).Elem()
	input, err := objectSchema(inputType, 0)
	if err != nil {
		r.err = fmt.Errorf("tool %q Input: %v", name, err)
		return r
	}
	output, err := objectSchema(outputType, 0)
	if err != nil {
		r.err = fmt.Errorf("tool %q Output: %v", name, err)
		return r
	}
	r.input, r.output = input, output
	r.call = func(ctx context.Context, requestID string, arguments json.RawMessage) (json.RawMessage, error) {
		var raw any
		if err := json.Unmarshal(arguments, &raw); err != nil {
			return nil, errors.New("the arguments are not valid JSON")
		}
		if err := validate(input, raw, "arguments"); err != nil {
			return nil, err
		}
		// The schema check already refused unknown keys; the strict decode
		// keeps that guarantee inside the authored Go type itself.
		decoder := json.NewDecoder(bytes.NewReader(arguments))
		decoder.DisallowUnknownFields()
		var in I
		if err := decoder.Decode(&in); err != nil {
			return nil, errors.New("the arguments do not match the tool's Input type")
		}
		result, err := execute(ctx, in)
		if err != nil {
			return nil, err
		}
		encoded, err := json.Marshal(result)
		if err != nil {
			return nil, errors.New("the tool output could not be encoded as JSON")
		}
		var decoded any
		if err := json.Unmarshal(encoded, &decoded); err != nil {
			return nil, errors.New("the tool output could not be encoded as JSON")
		}
		if err := validate(output, decoded, "tool output"); err != nil {
			return nil, err
		}
		return encoded, nil
	}
	return r
}

// hostMain serves the protocol until stdin is exhausted.
func hostMain(registry []registration) {
	instanceID := fmt.Sprintf("go:%d", os.Getpid())
	tools := map[string]registration{}
	var order []string
	var loadErr error
	for _, r := range registry {
		if r.err != nil && loadErr == nil {
			loadErr = r.err
		}
		tools[r.name] = r
		order = append(order, r.name)
	}
	sort.Strings(order)

	reader := bufio.NewReaderSize(os.Stdin, 4096)
	writer := bufio.NewWriter(os.Stdout)
	for {
		line, err := readLine(reader)
		if errors.Is(err, io.EOF) {
			return
		}
		if err != nil {
			// A line over the bound is never truncated and never partially
			// interpreted: the host stops.
			os.Exit(1)
		}
		if len(bytes.TrimSpace(line)) == 0 {
			continue
		}
		var request struct {
			ID     string `json:"id"`
			Method string `json:"method"`
			Params *struct {
				Name      string          `json:"name"`
				Arguments json.RawMessage `json:"arguments"`
			} `json:"params"`
		}
		if err := json.Unmarshal(line, &request); err != nil {
			write(writer, response{ID: "", Error: "the request line is not one JSON object"})
			continue
		}
		if loadErr != nil {
			write(writer, response{ID: request.ID, Error: bound(loadErr.Error())})
			continue
		}
		switch request.Method {
		case "list":
			listed := make([]any, 0, len(order))
			for _, name := range order {
				r := tools[name]
				listed = append(listed, map[string]any{
					"name":         r.name,
					"description":  r.description,
					"inputSchema":  r.input,
					"outputSchema": r.output,
				})
			}
			write(writer, response{ID: request.ID, Result: map[string]any{
				"instanceId": instanceID,
				"tools":      listed,
			}})
		case "call":
			if request.Params == nil {
				write(writer, response{ID: request.ID, Error: "the call carries no parameters"})
				continue
			}
			r, known := tools[request.Params.Name]
			if !known {
				write(writer, response{ID: request.ID, Error: "unknown tool"})
				continue
			}
			output, err := r.call(context.Background(), request.ID, request.Params.Arguments)
			if err != nil {
				write(writer, response{ID: request.ID, Error: bound(err.Error())})
				continue
			}
			write(writer, response{ID: request.ID, Result: map[string]any{
				"instanceId": instanceID,
				"output":     json.RawMessage(output),
			}})
		default:
			write(writer, response{ID: request.ID, Error: "the host protocol supports list and call"})
		}
	}
}

type response struct {
	ID     string `json:"id"`
	Result any    `json:"result,omitempty"`
	Error  string `json:"error,omitempty"`
}

func write(w *bufio.Writer, r response) {
	encoded, err := json.Marshal(r)
	if err != nil {
		encoded, _ = json.Marshal(response{ID: r.ID, Error: "the response could not be encoded"})
	}
	w.Write(encoded)
	w.WriteByte('\n')
	w.Flush()
}

// readLine returns one bounded line without its terminator.
func readLine(r *bufio.Reader) ([]byte, error) {
	var line []byte
	for {
		chunk, err := r.ReadSlice('\n')
		line = append(line, chunk...)
		if len(line) > maxLineBytes {
			return nil, errors.New("one request line exceeded the bounded size")
		}
		if errors.Is(err, bufio.ErrBufferFull) {
			continue
		}
		if err != nil {
			if errors.Is(err, io.EOF) && len(line) > 0 {
				return line, nil
			}
			return nil, err
		}
		return bytes.TrimRight(line, "\r\n"), nil
	}
}

func bound(text string) string {
	flat := strings.Join(strings.Fields(text), " ")
	if len(flat) > maxErrorChars {
		return flat[:maxErrorChars] + "..."
	}
	return flat
}

// objectSchema renders one authored Input or Output type as a JSON Schema
// object. The top level must be a struct: a tool's arguments and result are
// named fields, not a bare value.
func objectSchema(t reflect.Type, depth int) (map[string]any, error) {
	for t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	if t.Kind() != reflect.Struct {
		return nil, fmt.Errorf("must be a struct, not %s", t.Kind())
	}
	return schemaFor(t, depth)
}

// schemaFor renders one Go type as a JSON Schema. Unsupported kinds are
// refused rather than published as an untyped surface.
func schemaFor(t reflect.Type, depth int) (map[string]any, error) {
	if depth > maxSchemaDepth {
		return nil, errors.New("is nested more deeply than the host renders")
	}
	for t.Kind() == reflect.Pointer {
		t = t.Elem()
	}
	switch t.Kind() {
	case reflect.String:
		return map[string]any{"type": "string"}, nil
	case reflect.Bool:
		return map[string]any{"type": "boolean"}, nil
	case reflect.Int, reflect.Int8, reflect.Int16, reflect.Int32, reflect.Int64,
		reflect.Uint, reflect.Uint8, reflect.Uint16, reflect.Uint32, reflect.Uint64:
		return map[string]any{"type": "integer"}, nil
	case reflect.Float32, reflect.Float64:
		return map[string]any{"type": "number"}, nil
	case reflect.Slice, reflect.Array:
		if t.Kind() == reflect.Slice && t.Elem().Kind() == reflect.Uint8 {
			// []byte marshals as a base64 string.
			return map[string]any{"type": "string", "contentEncoding": "base64"}, nil
		}
		items, err := schemaFor(t.Elem(), depth+1)
		if err != nil {
			return nil, err
		}
		return map[string]any{"type": "array", "items": items}, nil
	case reflect.Map:
		if t.Key().Kind() != reflect.String {
			return nil, errors.New("uses a map with non-string keys")
		}
		values, err := schemaFor(t.Elem(), depth+1)
		if err != nil {
			return nil, err
		}
		return map[string]any{"type": "object", "additionalProperties": values}, nil
	case reflect.Struct:
		properties := map[string]any{}
		var required []string
		for i := 0; i < t.NumField(); i++ {
			field := t.Field(i)
			if !field.IsExported() {
				continue
			}
			name, optional, ok := fieldName(field)
			if !ok {
				continue
			}
			schema, err := schemaFor(field.Type, depth+1)
			if err != nil {
				return nil, err
			}
			properties[name] = schema
			if !optional && field.Type.Kind() != reflect.Pointer {
				required = append(required, name)
			}
		}
		sort.Strings(required)
		schema := map[string]any{
			"type":                 "object",
			"properties":           properties,
			"additionalProperties": false,
		}
		if len(required) > 0 {
			schema["required"] = required
		}
		return schema, nil
	default:
		return nil, fmt.Errorf("uses the unsupported type %s", t.Kind())
	}
}

// fieldName resolves one struct field's JSON name and whether it is optional.
func fieldName(field reflect.StructField) (name string, optional, ok bool) {
	tag := field.Tag.Get("json")
	if tag == "-" {
		return "", false, false
	}
	name = field.Name
	parts := strings.Split(tag, ",")
	if parts[0] != "" {
		name = parts[0]
	}
	for _, part := range parts[1:] {
		if part == "omitempty" || part == "omitzero" {
			optional = true
		}
	}
	return name, optional, true
}

// validate checks one decoded JSON value against a rendered schema, naming
// the offending path. It is the same check for arguments and for tool output,
// so neither direction is looser than the published surface.
func validate(schema map[string]any, value any, path string) error {
	switch schema["type"] {
	case "object":
		object, ok := value.(map[string]any)
		if !ok {
			return fmt.Errorf("%s must be a JSON object", path)
		}
		properties, _ := schema["properties"].(map[string]any)
		if properties != nil {
			var unexpected []string
			for key := range object {
				if _, known := properties[key]; !known {
					unexpected = append(unexpected, key)
				}
			}
			if len(unexpected) > 0 {
				sort.Strings(unexpected)
				return fmt.Errorf("%s carries unexpected fields: %s", path, strings.Join(unexpected, ", "))
			}
			if required, ok := schema["required"].([]string); ok {
				for _, key := range required {
					if _, present := object[key]; !present {
						return fmt.Errorf("%s is missing the required field %s", path, key)
					}
				}
			}
			for key, raw := range object {
				child, _ := properties[key].(map[string]any)
				if child == nil {
					continue
				}
				if err := validate(child, raw, path+"."+key); err != nil {
					return err
				}
			}
			return nil
		}
		if values, ok := schema["additionalProperties"].(map[string]any); ok {
			for key, raw := range object {
				if err := validate(values, raw, path+"."+key); err != nil {
					return err
				}
			}
		}
		return nil
	case "array":
		items, ok := value.([]any)
		if !ok {
			return fmt.Errorf("%s must be a JSON array", path)
		}
		child, _ := schema["items"].(map[string]any)
		if child == nil {
			return nil
		}
		for i, raw := range items {
			if err := validate(child, raw, fmt.Sprintf("%s[%d]", path, i)); err != nil {
				return err
			}
		}
		return nil
	case "string":
		if _, ok := value.(string); !ok {
			return fmt.Errorf("%s must be a string", path)
		}
		return nil
	case "boolean":
		if _, ok := value.(bool); !ok {
			return fmt.Errorf("%s must be a boolean", path)
		}
		return nil
	case "integer":
		number, ok := value.(float64)
		if !ok || number != float64(int64(number)) {
			return fmt.Errorf("%s must be an integer", path)
		}
		return nil
	case "number":
		if _, ok := value.(float64); !ok {
			return fmt.Errorf("%s must be a number", path)
		}
		return nil
	default:
		return nil
	}
}
